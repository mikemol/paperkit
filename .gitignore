__pycache__/
*.pyc
.delta-cache.json
.checkcache.json
setup/.loadtest.lock

# Bazel convenience symlinks (point into the GB-scale cache; must never enter git or the Δ sandbox)
/bazel-*

# inbox/ — a drop point for OTHER sessions' findings and bug reports, deliberately outside this
# session's live git state.  Its README is tracked; incoming drops stay ignored; SETTLED
# correspondence is promoted into inbox/archive/ (tracked) by a deliberate human act.
/inbox/*
!/inbox/README.md
!/inbox/archive/

# Ζ·sched-batch — the lazy-built helper binary (arch-specific; source tools/sched-batch.rs is tracked)
tools/sched-batch

# The summit drop zone: incoming letters must not dirty this tree.
# Ruling: ~/github/summit/proceedings/rulings/inbox-drop-zone.md
#
# Satisfied by `/inbox/*` + `!/inbox/archive/` above, which already ignores an incoming drop at
# /inbox/<letter>.md while keeping the promoted archive tracked. Summit's provisioner previously
# appended a generic `/inbox/` HERE; because gitignore is last-match-wins that overrode the
# `!/inbox/archive/` negation on line 15, so a NEWLY promoted settled letter was silently ignored
# (the five already-tracked ones kept working, which is what hid it). Removed by summit
# 2026-08-14 — floor/reports.bib `friction-provisioner-clobbers-a-carve-out`, reported by
# cassian-observability after the same clobber hit its A119 archive.
.githooks/local.env

# Ζ·pkg·shape — wheel-build residue.  setuptools writes these beside the source; they are
# derived, and a repo whose every documentary artifact is a PROJECTION should not carry
# build output it did not project.
build/
dist/
*.egg-info/

# Ρ·deck — the emitted decks.  render's coalgebra carries pptx/odp as format objects and the
# engine EMITS them (render/checks/deck_bound.py); like render's own .docx/.pdf/.odt, none of
# which is tracked, they are build output the repo did not project — the same rule as above.
talk/talk.odp
talk/talk.pptx
