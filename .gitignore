__pycache__/
*.pyc
.delta-cache.json
.checkcache.json
setup/.loadtest.lock

# Bazel convenience symlinks (point into the GB-scale cache; must never enter git or the Δ sandbox)
/bazel-*

# inbox/ — a drop point for OTHER sessions' findings and bug reports, deliberately outside this
# session's live git state.  Its README is tracked; incoming drops stay ignored; SETTLED
# correspondence is promoted into inbox/archive/ (tracked) by a deliberate human act.
/inbox/*
!/inbox/README.md
!/inbox/archive/

# Ζ·sched-batch — the lazy-built helper binary (arch-specific; source tools/sched-batch.rs is tracked)
tools/sched-batch

# The summit drop zone: incoming letters must not dirty this tree.
# Ruling: ~/github/summit/proceedings/rulings/inbox-drop-zone.md
#
# Satisfied by `/inbox/*` + `!/inbox/archive/` above, which already ignores an incoming drop at
# /inbox/<letter>.md while keeping the promoted archive tracked. Summit's provisioner previously
# appended a generic `/inbox/` HERE; because gitignore is last-match-wins that overrode the
# `!/inbox/archive/` negation on line 15, so a NEWLY promoted settled letter was silently ignored
# (the five already-tracked ones kept working, which is what hid it). Removed by summit
# 2026-08-14 — floor/reports.bib `friction-provisioner-clobbers-a-carve-out`, reported by
# cassian-observability after the same clobber hit its A119 archive.
.githooks/local.env

# Ζ·pkg·shape — wheel-build residue.  setuptools writes these beside the source; they are
# derived, and a repo whose every documentary artifact is a PROJECTION should not carry
# build output it did not project.
build/
dist/
*.egg-info/

# Ρ·deck — the emitted decks.  render's coalgebra carries pptx/odp as format objects and the
# engine EMITS them (render/checks/deck_bound.py); like render's own .docx/.pdf/.odt, none of
# which is tracked, they are build output the repo did not project — the same rule as above.
talk/talk.odp
talk/talk.pptx

# Agda build artifacts (Ζ·pyc: a .agdai is derived, like a .pyc or a .o)
*.agdai

# Ζ·bibstruct·root — edit_snapshot's write journal + snapshot store, runtime artifacts of the
# vendored write-guard (paperkit/tools/edit_snapshot.py).  Written beside the tool whenever a
# `bibstruct --add/--set/--addfield --apply` runs, including in its own selftest; a record of
# what a mutation touched, not a source the engine reads.
paperkit/scratch/
.edit-snapshots/

# Ζ·hook·regen — the regen hook's flock file (single-instance guard, runtime state).
.regen.lock

# Ζ·execlog·leak — the repo-local scratch dir.  `.githooks/pre-commit` exports TMPDIR here (off
# tmpfs, deliberately: a 4.45 GB execution log in RAM leaked across days), and bibstruct's
# selftest leaves a mkdtemp per run.  Build residue by construction — never a source.
.tmp/

# ⚑ Ζ·summit·recur — ANOTHER REPO'S COORDINATION DATA, WRITTEN INTO THIS TREE BY A PEER'S HOOK.
# `paperkit/summit/floor/` appeared twice on 2026-08-31 holding summit's floor bibs — first one
# file (142 friction reports, 331 KB), then three (719 KB, +asks +corroboration).  It is NOT
# paperkit's: nothing here references `summit/floor`, and the live floor is `substrate/scratch/
# summit/floor/`.  The writer is one of the PreToolUse hooks symlinked from ../../substrate
# (Κ·hook·vendor's accepted cost: an adopter inherits upstream's bugs with its fixes).
#
# ⚑⚑ THIS IS A SYMPTOM FIX AND SAYS SO.  The cause is a cross-repo writer composing a path this
# repo never declares — the inbox convention (`/inbox/*`, ignored, ruling at summit's
# inbox-drop-zone.md) exists precisely so an incoming drop cannot dirty the tree, and it works;
# what bypassed it was a write that never went near it.  An ignore rule only protects paths it
# knows about, so this stops the NEXT one from being swept in by `git add -A` (summit's own floor
# records that exact failure as `friction-git-add-A-swept-a-delegate-letter-into-an-unrelated-
# commit`) without pretending the write has been prevented.
/summit/
paperkit/summit/
