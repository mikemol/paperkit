# Hand-maintained Bazel infra (Ζ·sunset).  The per-claim check graph is GENERATED by Ζ·starlark
# (tools/bibtex.bzl reads each project's warrants.bib) into @paperkit_* repos — the bib is the sole
# source, no checked-in BUILD projection.  This file keeps only: the root project's file manifest
# (:files — a data dep of the generated targets; includes this BUILD + MODULE so bnd-check can read
# them), and the local-CI suite (//:hook).
filegroup(name = "files", srcs = [
        ".containerignore",
        ".githooks/pre-commit",
        ".gitignore",
        "BUILD.bazel",
        "MODULE.bazel",
        "Containerfile",
        "Containerfile.base",
        "README.md",
        "assets/claim.bib",
        "assets/commands.sh",
        "assets/delta-cmds.sh",
        "assets/enable-hooks.sh",
        "assets/fields.md",
        "assets/grades.md",
        "assets/layout.txt",
        "assets/resolver.md",
        "assets/resolver.toml",
        "checks/gen_fields.py",
        "checks/readme.py",
        "paper.toml",
        "rubric.tsv",
        "warrants.bib",
        # Ξ·lint·wire — the .bzl + the lint tool, so the boundaries bnd-lint check can lint them.
        "//tools:lint_bzl.py",
        "//tools:calc.bzl",
        "//tools:verb.bzl",
        "//tools:grade.bzl",
        "//tools:bibtex.bzl",
        "//tools:witness.bzl",
        # Ζ·ladder·wire — the ladder's downstream consumers, so bnd-ladder can read them and prove
        # none re-declares the rungs.  The report is on-demand (not in //:hook), but its summary is
        # exactly where an omitted rung last went unnoticed, so it is gated as a READER here.
        "//tools:verdict.py",
        "//report:gen.py",
        "//report:figure.py",
        # Μ·kernel·wire — the component partition, the import DAG, and their deriving tool, so
        # bnd-components can verify the engine's boundary from the owners (never a copy).
        "//paperkit:components.bzl",
        "//paperkit:dag.bzl",
        "//tools:imports.py",
        # Ζ·bnd·toplevel derives its read semantics from the owner (closure.py's _reads).
        "//tools:closure.py",
        # Ζ·hook·index — bnd-hook-index gates the equivalence predicate's pure core.
        "//tools:hook_index.py",
        "//tools:otlp_push.py",
        # ⚑ Ζ·pyc·package — `tools` IS A PACKAGE IN THE SANDBOX ONLY IF ITS MARKER IS STAGED.
        # This manifest listed individual `tools/*.py` files and no `__init__.py`, which was
        # sufficient while every consumer reached them by `sys.path.insert` + a flat import.  A
        # suite that names the edge honestly (`from tools import dagderive`) then fails with
        # ModuleNotFoundError inside a cell while passing on the host, where the editable install
        # supplies the package — five boundary suites reddened exactly that way.
        #
        # ⚑⚑ AND THE THREE MODULES BELOW WERE NEVER DECLARED AT ALL.  Same class as the
        # `bibparse.py` omission components.bzl records costing four batch runs: a file on disk
        # that no manifest names is invisible to the build, and the failure surfaces far from the
        # cause.  Ξ·dag·dotted split the DAG derivation out of imports.py into dagderive+dagbzl,
        # and Ζ·hook·index split the pure predicate into indexdiverge — each a new file the
        # consuming suites now import BY NAME.
        "//tools:__init__.py",
        "//tools:dagderive.py",
        "//tools:dagbzl.py",
        # Ξ·dag·dotted — the PATH→module-name translation, imported by bnd-config.  Undeclared, a
        # sandboxed cell raises ModuleNotFoundError while the host passes (the editable install
        # supplies it) — AND the action cache never invalidates, so the check reports a STALE
        # verdict rather than a red: measured, bnd-config kept serving its pre-fix failure across
        # three gate runs with "48 action cache hit" and no re-execution.
        "//tools:dagnames.py",
        # Ξ·dag·script — the closure census: which witnesses shell out to a sibling generator whose
        # engine cone their declared closure does not cover.  It reads closure.py's OWN output
        # (never a re-derivation), so it is staged beside the tool it audits.
        "//tools:closure_census.py",
        "//tools:indexdiverge.py",
    ], visibility = ["//visibility:public"])

# The local CI: `bazel test //:hook` IS the pre-commit (Ζ·hook / Ζ·foot·hook) — it gates AND grades
# every document as a graph of per-claim check targets.  bnd-check verifies this suite is complete.
test_suite(name = "hook", tests = [
    # Ζ·canary — the harness's POSITIVE CONTROL (one global member, a harness property): a
    # guaranteed-flip pk_eval that MUST flip + the ∅ identity that MUST NOT, off the same
    # bazel-staged-.pyc delivery every grid row uses — so a silently degraded sandbox
    # (processwrapper fallback) turns the whole hook RED with a NAMED error instead of the
    # sweep quietly grading everything indeterminate.  ⟨P,F,δ⟩ proven against the real
    # failure: P green under --config=mutant, F red under --spawn_strategy=processwrapper.
    "//canary:canary",
    "@paperkit_root//:gate",
    "@paperkit_paper//:gate",
    "@paperkit_boundaries//:gate",
    # Ζ·hook-rot — config is wired (bib.project) but declares neither adequacy nor emerge, so
    # bnd-check's completeness never OWED it a member; its gate rotted silently outside the hook.
    # Ζ·config·adequacy — now ADEQUACY-graded too, not gate-only.  Four cmd: checks against the
    # INTROSPECTED knob union: an exit code alone says they ran, never that a mutation could flip
    # them, and a registry check that cannot fail is the one that most looks like coverage.
    "@paperkit_config//:gate",
    "@paperkit_config//:adequacy",
    # Ζ·consumer-fields·demo — paperkit's own use of a declared consumer field, gated every commit so
    # the declared-field carry/suppress path has a live in-tree exercise.  Ζ·demo·adequacy adds the
    # SWEEP: a non-vacuous pass was the stated intent and the exit code never measured it — this
    # project exists to prove a parse path stays quiet, which is exactly a claim a mutation must flip.
    # (No quoted phrases in these comments: bnd-check reads quoted tokens out of the member list, so
    # scare-quotes here parse as a bogus hook member — it caught exactly that.)
    "@paperkit_demo//:gate",
    "@paperkit_demo//:adequacy",
    "@paperkit_paper//:adequacy",
    "@paperkit_root//:adequacy",
    # Λ·witness — the concept LIBRARY: it self-grades each concept witness (adequacy) and gates its
    # own coherence; views' concept: checks import its certificates.  Ζ·delegate-cover keeps it here.
    "@paperkit_library//:gate",
    "@paperkit_library//:adequacy",
    "@paperkit_library//:cohere",
    # Σ·step5 — the GUIDE: a view composed entirely from library concept certificates plus a
    # self-verifying starter (its check runs the gate on the starter).  Zero witness code.
    "@paperkit_guide//:gate",
    "@paperkit_guide//:adequacy",
    # Ζ·tier — the RENDER project, mixed-tier: its gate runs every warrant — the pure compliance checks
    # hermetically, the render/oracle checks under the host toolchain (tier=toolchain, CACHED + stamped
    # with the toolchain fingerprint, so the gate is fast: a toolchain check re-runs only when the
    # toolchain or its input changes).  Its adequacy mutation-sweeps ONLY the sandbox subset — so the
    # WCAG standards model, the capability coalgebra, and the use-of-colour predicate are
    # architecturally enforced AND falsifiability-graded every commit (closing the self-certification
    # the enforcement adversary found).  No cohere (adequacy+calc, no emerge).
    "@paperkit_render//:gate",
    "@paperkit_render//:adequacy",
    # Ρ·talk·hook·wire — the conference TALK.  It was built to a deadline and lived outside the
    # hook, so its figure family, its dispatch-table totality gate and its 16 witnesses were
    # hand-invoked only: verified once by a human, guaranteed by nothing.  That is Ζ·hook-rot
    # arriving the other way round — not wired-then-rotted, but never wired at all.  Its
    # witnesses assert things about OTHER projects' bibs (render's warrants back the talk's
    # pipeline claims), so adequacy matters: an unswept witness would let the talk claim a
    # guarantee nobody gates.
    "@paperkit_talk//:gate",
    "@paperkit_talk//:adequacy",
    # Ζ·emerge·gate — the ∂² coherence reading over each emerge project's def-sweep GRID (the
    # Ξ·dag·eval closure cells).  Pulls the grid into //:hook, so the hook runs under --config=mutant
    # (the hermetic sandbox the mutation cells require; .githooks/pre-commit passes it).
    "@paperkit_paper//:cohere",
    "@paperkit_root//:cohere",
    # Μ·sweep·atom — the DECISION-COVERAGE summary over each emerge project's flip:/dflip: grid cells
    # (the non-monotone half of the Klein-four atom).  Built every commit so the grid twin is CONSUMED,
    # not emitted-but-inert (the enforcement adversary's finding); an orthogonal axis, so it reds only
    # on a malformed record (a partition/aggregation regression), never on an unasserted-decision count.
    "@paperkit_paper//:decisions",
    "@paperkit_root//:decisions",
    # Λ·hook·owner — library's decisions summary was ABSENT, and nothing recorded a reason.
    # MEASURED 2026-09-02 by query: exactly three decisions: targets exist across every project
    # (root, paper, library) and exactly three cohere: targets exist, over the same three — the
    # generator emits both kinds for precisely the emerge projects.  The cohere: row above was
    # complete; this one listed two of the same three.  Cost is not the discriminator either:
    # library would add 18,714 marginal targets against paper's existing 19,438, the same order.
    # So library's grid twin was BUILT every commit and CONSUMED by nothing — which is exactly the
    # emitted-but-inert finding the Μ·sweep·atom note above exists to refuse, reappearing one
    # project over.  A green target outside the suite is [[instrument-vs-gate]]: it produces signal
    # and is never a control.
    #
    # ⚑ AND THE CLASS IS THIS LIST, NOT THIS LINE.  These members are a per-project x per-target-kind
    # GRID that tools/bibtex.bzl already knows in full — it reads every project's emerge/adequacy/calc
    # status and emits every kind from it — but the grid is transcribed BY HAND here, in a file the
    # generator cannot see.  So adding a per-project kind requires an edit no owner is forced to make,
    # and the SECOND such kind (decisions:, after cohere:) is the one that got missed.  All 23 members
    # can fall out this way, silently.  [[place-by-ownership-not-need]]; see the report accompanying
    # this commit for the generated-membership options.
    "@paperkit_library//:decisions",
])
