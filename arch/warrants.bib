  section = {structure},
  claim   = {the engine is partitioned into EIGHT COMPONENTS --- delta, gate, kernel, library_kernel, model, project, resolver and tests --- and that partition is the one bnd-components gates as TOTAL and DISJOINT over the real tree, so a file belonging to no component is a build error rather than a documentation gap},
  check   = {claim:arch-components},
  reads    = {.}
}

@misc{arch-modules,
  section = {structure}, from = {arch-components}, rests-on = {arch-components},
  claim   = {those components hold TWENTY-SIX non-test modules, which is a DIFFERENT count from the eight components --- the distinction matters because this document once asserted seventeen, a number matching neither, and a count in prose is a claim nothing re-derives},
  check   = {claim:arch-modules},
  reads    = {.}
}

@misc{arch-projects,
  section = {structure}, from = {arch-modules},
  claim   = {the repository wires THIRTEEN projects in MODULE.bazel, and every one of them names a directory that really carries a paper.toml --- the wiring is the roster a reader would otherwise count by hand, and a tag naming a project that is not there would be a build graph asserting a document exists. This number changed WITHIN the tick that introduced the witness, when arch itself was wired, which is the counting claim earning its place},
  check   = {claim:arch-projects},
  % ⚑ Ζ·reads·file — THE WIRED ROSTER, ENUMERATED AS LABELS, AND GATED.  This witness reads
  % MODULE.bazel (the roster it counts) and stats each wired project's paper.toml (the existence it
  % asserts).  `reads = {.}` would stage the whole root filegroup; a per-package read would flatten
  % "opens 13 paper.tomls" into "depends on 13 packages".  Operator's ruling: "we should express
  % dependencies on the specific files needed" and "I don't like directories as read targets".
  % ⚑⚑ ENUMERATING THE ROSTER HERE WOULD BE A GUARD CARRYING ITS OWN COPY OF THE SET IT GUARDS —
  % except that bnd-roster-wired GATES this list against MODULE.bazel's bib.project calls, and the
  % operator's construction is exactly that: "This is when you have a gate that verifies that two
  % copies are in sync."  An enumerated input WITH a sync gate is a declaration, not a tautology.
  builds   = {@@//:MODULE.bazel, @@//:paper.toml, @@//arch:paper.toml, @@//boundaries:paper.toml, @@//config:paper.toml, @@//demo:paper.toml, @@//guide:paper.toml, @@//image:paper.toml, @@//paper:paper.toml, @@//paperkit/library:paper.toml, @@//render:paper.toml, @@//report:paper.toml, @@//setup:paper.toml, @@//talk:paper.toml}
}

@misc{arch-two-pk-grade,
  section = {tensions},
  claim   = {TWO rules named pk_grade exist, in tools/grade.bzl and tools/calc.bzl, never loaded together --- benign but a collision that can mislead a reader who greps for one and finds the other},
  check   = {claim:arch-two-pk-grade},
  reads    = {.}
}

@misc{arch-report-scope,
  section = {tensions}, from = {arch-two-pk-grade},
  claim   = {the report's document census now covers every wired project rather than three --- this entry RETIRES a tension that read that the committed report covered only paper, README and boundaries while render, image, config and setup were unrepresented, and it is gated so the retirement goes red if the scope narrows again},
  check   = {claim:arch-report-scope},
  % ⚑ Ζ·reads·file — THE DISCOVERED SET.  This witness imports report/gen.py, whose _all_docs()
  % does ROOT.rglob("paper.toml") — the projects are DISCOVERED by walking the tree, not declared.
  % Enumerated as labels anyway (every one is an exported file) and gated by bnd-roster-wired, so
  % a project appearing on disk without reaching this list reds rather than silently narrowing the
  % census this claim asserts.  guide/assets/starter is EXCLUDED and that is deliberate: it has no
  % BUILD.bazel because it is a starter FIXTURE, not a project — gen.py's own filter drops it.
  builds   = {@@//report:gen.py, @@//report:figure.py, @@//:paper.toml, @@//arch:paper.toml, @@//boundaries:paper.toml, @@//config:paper.toml, @@//demo:paper.toml, @@//guide:paper.toml, @@//image:paper.toml, @@//paper:paper.toml, @@//paperkit/library:paper.toml, @@//render:paper.toml, @@//report:paper.toml, @@//setup:paper.toml, @@//talk:paper.toml}
}

@misc{arch-two-tiers,
  section = {tensions}, from = {arch-report-scope}, rests-on = {arch-report-scope},
  claim   = {no document is on-demand any more --- this entry RETIRES a tension that read that render, image and report gated on-demand so the hook did not exercise their presentation and reproducibility claims; the retirement is a witness rather than a deletion, because a tensions ledger whose entries go stale SILENTLY is the defect claims exist to prevent},
  check   = {claim:arch-two-tiers},
  reads    = {., report}
}

@misc{arch-roster-wired,
  section  = {structure},
  claim    = {the label rosters this project ENUMERATES are gated against the owners that define them --- arch-projects names every wired project's paper.toml and arch-report-scope names every paper.toml the report census discovers, both as explicit labels so a witness depends on the files it opens rather than on whole packages, and an enumeration with nothing checking it is a guard carrying its own copy of the set it guards; so MODULE.bazel's bib.project calls and the tracked paper.toml files are read as the two OWNERS and compared against the two enumerations in both directions, which is what makes the duplication a declaration rather than a tautology --- the starter fixture under guide/assets is excluded deliberately and said so here, because an undeclared exclusion is the defect a roster gate exists to prevent},
  check    = {cmd:python3 ../paperkit/tests/boundaries_roster_wired.py},
  % ⚑ Ζ·reads·file — the two OWNERS, as labels: the wiring manifest and this bib.
  % ⚑ Ζ·roster·hermetic — THE 13 paper.toml FILES ARE DECLARED, so the cell's filesystem walk
  % measures the DECLARATION rather than a different tree.  The suite no longer shells `git
  % ls-files`: in a sandbox that read the real index (15 files, via the .git symlink) while every
  % stat hit the staged copy (1 file).  Declaring them makes declaration and measurement one
  % object — a project that reaches this list is visible to the walk, one that does not is not.
  builds   = {@@//:MODULE.bazel, @@//arch:warrants.bib, @@//:paper.toml, @@//arch:paper.toml, @@//boundaries:paper.toml, @@//config:paper.toml, @@//demo:paper.toml, @@//guide:paper.toml, @@//image:paper.toml, @@//paper:paper.toml, @@//paperkit/library:paper.toml, @@//render:paper.toml, @@//report:paper.toml, @@//setup:paper.toml, @@//talk:paper.toml}
}
