@misc{bnd-sandbox,
  section = {runtime}, from = {bnd-cache}, join = {. },
  claim   = {the Δ sandbox's boundary --- the mutation copy takes the bounded root WHOLE (the bound lives on the root, not a lossy per-dir skip) save for SKIP_DIRS, which prune .git and the bazel-* cache links from both the copy and the deep nested-project walk so an artifact never explodes the sandbox, and that root is DECLARABLE (the PAPERKIT_ROOT environment variable, which a --root flag overrides, or paper.toml) and otherwise inferred as the parent --- but inferring a home directory or above is REFUSED with guidance, so a downstream project living in a home that also holds a clone or cache does not explode the disk; and the copy allocates a FRESH INODE per file, which is what makes Δ's in-place mutation safe at all --- write_text writes THROUGH an inode, so a link-preserving copy would send every mutant into the original tree and into any hardlinked twin outside it, and on a machine where deduplication has run those twins reach other repositories entirely},
  check   = {cmd:python3 ../paperkit/tests/boundaries_sandbox.py}
}
