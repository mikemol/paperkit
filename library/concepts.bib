% concepts.bib — the concept-witness LIBRARY's own records: one entry per concept FACE, each a
% cmd: witness the library GRADES once (a def-sweep → the certificate every VIEW imports).  The
% prose faces (the README pitch, the paper deep exposition) are authored in their own views; these
% are the minimal grading records that OWN the certificate.  Two keys share one witness
% (concepts.py maps both to adequacy_pitch) so each view imports under the key it cites.

@misc{adequacy-pitch,
  section = {adequacy},
  claim   = {the adequacy witness runs the real grader over a fixture, so mutating an engine def-site flips it --- the certificate's sensitivity fingerprint IS the engine, which every importing view inherits},
  check   = {claim:adequacy-pitch}
}

@misc{grade-ladder,
  section = {adequacy},
  claim   = {the same witness under the deep key certifies the grade ladder --- a presupposed file grades vacuous, a content-sensitive command behavioral --- so the paper's deep exposition imports the identical proof the pitch does},
  check   = {claim:grade-ladder}
}

% ── delta: the Δ grader/coherence concepts (Μ·kernel·certs·delta), interned as canonical nodes.

@misc{crash-sensitive-limit,
  section = {delta},
  claim   = {Δ flags the relevance gap without closing it --- a check can grade behavioral while sensitive only to inputs other than the document's content, and content-sensitivity marks the difference, so behavioral is necessary but not sufficient for relevance},
  check   = {claim:crash-sensitive-limit}
}

@misc{imported-grade,
  section = {delta}, from = {crash-sensitive-limit}, join = {. },
  claim   = {one grade sits outside the falsifiability ladder --- a verdict-import is graded imported, its adequacy delegated to a sibling the gate verifies on its own, run once and never mutation-swept},
  check   = {claim:imported-grade}
}

@misc{sandbox-grade,
  section = {delta}, from = {imported-grade}, join = {. },
  claim   = {the sweep runs in a sandbox copy whose mutation surface excludes sibling projects (a nested directory with its own paper.toml), so each project grades independently of the others},
  check   = {claim:sandbox-grade}
}

@misc{grounding-reflected,
  section = {delta}, from = {sandbox-grade}, join = {. },
  claim   = {definition resolution turns each claim's sensitivity into an engine-capability fingerprint and checks declared grounding against it --- a rests-on edge whose fingerprint overlaps its premise's is reflected, a disjoint one from a claim that tests engine capability is a genuine miss, and one from a claim that tests nothing engine is vacuously discharged},
  check   = {claim:grounding-reflected}
}

@misc{emergence-collapse,
  section = {delta}, from = {grounding-reflected}, join = {; and stricter, },
  claim   = {emergence is the coverage sibling of grounding --- grounding asks whether a rests-on edge overlaps its premise's fingerprint, emergence whether a claim's whole fingerprint is covered by its premises', so a claim that adds no engine sensitivity beyond its grounding collapses while any residual is its irreducible increment},
  check   = {claim:emergence-collapse}
}

@misc{edge-rests-grounds,
  section = {delta}, from = {emergence-collapse}, join = {. },
  claim   = {rests-on is a separate grounding edge --- a claim's effective grade is clamped to the weakest grade along it, regardless of prose order},
  check   = {claim:edge-rests-grounds}
}

% Λ·cache·slice — WHEN a verdict may be reused is an adequacy question, so the slice cache is
% interned in delta beside the grading concepts rather than treated as build plumbing.
@misc{slice-cache,
  section = {delta}, from = {edge-rests-grounds}, join = {. },
  claim   = {a verdict is reusable exactly when nothing the check can REACH has changed, so the cache key is the check's slice --- its witness, the transitive closure of every top-level body it names, and the content of every module that closure reaches; a slice that reads only function bodies stops at a constant's own name and one that reads only names never leaves the file, and each omission serves a stale pass},
  check   = {claim:slice-cache}
}

@misc{rm-model,
  section = {model},
  claim   = {a claim is one bibliography entry --- a statement, its rubric section, its dependencies, and its check --- parsed by the engine's OWN bib reader, so mutating a parser def-site flips the witness and the certificate's fingerprint IS that parser},
  check   = {claim:rm-model}
}

@misc{claim-is-record,
  section = {model},
  claim   = {the same witness under the paper's key certifies that a claim is a single record --- the deep view imports the identical proof the README pitch does},
  check   = {claim:claim-is-record}
}

@misc{rm-verifier,
  section = {resolver},
  claim   = {each claim carries a machine-checkable verifier --- the check field names a verb and the gate RESOLVES it; the parser and the resolver are engine, so the certificate's fingerprint is them},
  check   = {claim:rm-verifier}
}

@misc{claim-bears-check,
  section = {resolver},
  claim   = {the same witness under the paper's key certifies that each claim bears a machine-checkable verifier},
  check   = {claim:claim-bears-check}
}

@misc{rm-resolver-cmd,
  section = {resolver},
  claim   = {cmd is the escape hatch every check reduces to, and a new domain adds a verifier in config without touching the engine --- a config-supplied type resolves, an unregistered one does not},
  check   = {claim:rm-resolver-cmd}
}

@misc{cmd-escape,
  section = {resolver},
  claim   = {the paper's cmd-escape face imports this same certificate --- cmd is the universal escape hatch every other check reduces to},
  check   = {claim:cmd-escape}
}

@misc{new-domain-adds,
  section = {resolver},
  claim   = {and the paper's new-domain-adds face too --- supporting a new domain means adding verifiers, not editing the engine},
  check   = {claim:new-domain-adds}
}

@misc{rm-noship,
  section = {gate},
  claim   = {an unverified sentence cannot ship --- a claim whose check FAILS blocks the gate; the gate is engine, so its def-sites are the fingerprint},
  check   = {claim:rm-noship}
}

@misc{fail-omits,
  section = {gate},
  claim   = {the paper's fail-omits face imports this same certificate --- a claim whose verifier fails simply does not appear in the prose},
  check   = {claim:fail-omits}
}

@misc{rm-cmds-inv,
  section = {gate},
  claim   = {the gate ENFORCES its invariants --- the committed prose equals its projection, and every cited claim's check passes --- so violating each makes it RED},
  check   = {claim:rm-cmds-inv}
}

@misc{gate-is-subject,
  section = {gate},
  claim   = {the paper's self-host face imports this same certificate --- the gate that accepts the paper is the very subject it describes, enforcing the invariants the paper states},
  check   = {claim:gate-is-subject}
}

@misc{adequacy-gap,
  section = {gate},
  claim   = {the gate is blind to RELEVANCE --- a passing check proves a sentence NAMED a verifier, not that the verifier ENTAILS the claim, so a false sentence with a behavioral yet irrelevant check still passes: verification here is adequacy, not proof of meaning},
  check   = {claim:adequacy-gap}
}

@misc{rm-resolver,
  section = {resolver},
  claim   = {the resolver component's certificate --- a verifier is named type:target, EVERY declared verb dispatches to a real branch (read from resolver.VERBS, nothing re-listed), the built-in set is closed, and a custom type dispatches through the registry},
  check   = {claim:rm-resolver}
}

@misc{verifier-named,
  section = {resolver},
  claim   = {the paper's verifier-named face imports this certificate --- the type prefix selects the verb},
  check   = {claim:verifier-named}
}

@misc{gate-dispatches,
  section = {resolver},
  claim   = {and its gate-dispatches face --- the gate dispatches through a small registry of check types, built-in and custom},
  check   = {claim:gate-dispatches}
}

@misc{two-builtins,
  section = {resolver},
  claim   = {and its two-builtins face --- a verifier ships built in per verb, and the set is pinned ENUMERATIVELY rather than by count, closing the adequacy gap that let a fifth verb falsify the prose silently},
  check   = {claim:two-builtins}
}

% Λ·key·graded — resolving a KEY to its witness is the resolver's other half (the verb dispatch
% above resolves a check's TYPE), so the graded key is interned here rather than in its own section.
@misc{graded-key,
  section = {resolver}, from = {two-builtins}, join = {; and },
  claim   = {a concept key is GRADED --- family, optional subfamily, argument --- and one depth-agnostic walk resolves every grade, so a flat key is the degenerate case rather than a separate mechanism, while two keys differing only in argument share one implementation yet stay distinct witnesses to the gate},
  check   = {claim:graded-key}
}

@misc{rm-pitch,
  section = {projector},
  claim   = {the projector component's certificate --- a document IS the projection of its claim-DAG: the title, every rubric section, and every claim's prose appear in the emitted document, which leads with a heading},
  check   = {claim:rm-pitch}
}

@misc{paper-is-projection,
  section = {projector},
  claim   = {the paper's thesis face imports this certificate --- a scholarly paper as the projection of a claim-DAG},
  check   = {claim:paper-is-projection}
}

@misc{projector-emits,
  section = {projector},
  claim   = {and its engine face --- the projector emits the whole document from the warrant set, populated sections and empty ones alike},
  check   = {claim:projector-emits}
}

@misc{rm-cmds,
  section = {projector},
  claim   = {two commands do the work --- PROJECT makes the document and GATE verifies it: the exact projection passes, hand-edited drift is rejected},
  check   = {claim:rm-cmds}
}

@misc{boundary-is-a-triple,
  section = {gate},
  claim   = {a tool's behavioural BOUNDARY is a triple and not a happy path --- a minimal input that PASSES, a minimal input that FLAGS, and the minimum DELTA between them, so the documented edge is the one the tool actually has; a tool shown only passing has an undefined boundary, since nothing distinguishes a check that discriminates from one that cannot fail, and the delta is what makes the pair a MEASUREMENT rather than two anecdotes},
  check   = {claim:boundary-is-a-triple}
}

@misc{capability-owned-as-data,
  section = {projector},
  claim   = {a capability MATRIX is owned as data with a named exception --- which target affords which capability is a declared cell, and a cell that cannot be afforded reads TOOLCHAIN-EXCEPTED rather than going silently absent, so an unsupported combination is a disclosed fact rather than a gap a reader must infer from silence},
  check   = {claim:capability-owned-as-data}
}

@misc{pipeline-is-a-coalgebra,
  section = {projector},
  claim   = {a conversion PIPELINE is a coalgebra tracked as data --- targets are OBJECTS and conversions are MORPHISMS in one declared adjacency, so a route is a WALK over declared edges rather than a script someone runs by hand, and a route naming an edge the adjacency does not declare is refused instead of discovered at run time},
  check   = {claim:pipeline-is-a-coalgebra}
}

@misc{derived-is-regenerated-not-trusted,
  section = {projector},
  claim   = {EVERY derived artifact is regenerated and compared, never trusted --- the generalisation of the prose drift face to every projection a project commits, so a table, a manifest or a figure that has drifted from the source it is derived from fails the gate exactly as drifted prose does; a committed derivative nothing regenerates is an assertion about the past},
  check   = {claim:derived-is-regenerated-not-trusted}
}

@misc{gate-rejects-drift,
  section = {projector},
  claim   = {the paper's drift face imports this same certificate --- the gate rejects any prose that has drifted from its projection},
  check   = {claim:gate-rejects-drift}
}

@misc{degeneracy-has-kinds,
  section = {projector},
  claim   = {DEGENERACY HAS KINDS --- a document with no grounding graph is degenerate for two different reasons, and reporting one verdict for both hides the actionable case: a document that declares no grounding at all may HAVE an argument and simply not have stated it, which its author can repair, while one whose declared grounding names nothing reachable has no argument here to ground, so the section cut is the honest answer and nothing is owed; the degenerate bit alone cannot tell a reader which repair, if any, is theirs to make},
  check   = {claim:degeneracy-has-kinds}
}

% ── cotype: the layer that gates REASONING rather than claims.  A landed claim carries a command;
% printed reasoning and a cross-session ledger carry nothing, and every gate above is blind to them.

@misc{conclusion-backed,
  section = {cotype},
  claim   = {a printed conclusion must be backed by an assertion that would fail if it were false --- the check apparatus covers landed claims, each carrying a command, while printed reasoning carries nothing, so a conclusion can sit beside output from the same run that refutes it and no gate notices},
  check   = {claim:conclusion-backed}
}

@misc{conclusion-weak-direction,
  section = {cotype}, from = {conclusion-backed}, join = {, and },
  claim   = {the gate is deliberately weak in one direction and strong in the other --- it cannot tell whether an assertion is the RIGHT one, only that a conclusion was staked with nothing behind it, because a gate that judged relevance would have to be right about meaning and would fail open when it was not},
  rests-on = {conclusion-backed},
  check   = {claim:conclusion-weak-direction}
}

@misc{label-carrier,
  section = {cotype}, from = {conclusion-weak-direction}, join = {. },
  claim   = {a label is a point in an orbit --- it names a concept from the carrier one was standing in, so a concept has one identity and many labels, and a foreign corpus splits into what to REUSE, where an existing witness family already covers the idea and the term becomes another argument to it, and what to WEDGE},
  check   = {claim:label-carrier}
}

% ── the concept verb and the library seam itself (Ρ·paper·concept): the library's records for
%    the concepts that describe what a library IS.  Self-referential on purpose — the mechanism
%    that certifies every other concept is certified the same way.

@misc{concept-builtin,
  section = {resolver},
  claim   = {the concept verb IMPORTS rather than runs --- the engine's own registry types it as a boundary-crossing import, and a citation grades `imported`, its adequacy delegated to the library that graded it once},
  check   = {claim:concept-builtin}
}

@misc{concept-interned,
  section = {resolver},
  claim   = {a library is a HASH-CONS table --- two keys naming one concept resolve to the SAME canonical witness object rather than to copies that could drift, and a singly-cited concept is canonical too, so interning is a property of being a concept and not a reward for repetition},
  check   = {claim:concept-interned}
}

@misc{concept-views,
  section = {resolver},
  claim   = {one truth carries SEVERAL prose faces --- measured against the live corpus, a shared key is cited from more than one project, so distinct views state a concept in their own register while importing the identical proof},
  check   = {claim:concept-views}
}

@misc{concept-shareable,
  section = {resolver},
  claim   = {the seam resolves CONSUMER-FIRST with per-key fallthrough --- a project's own library answers a key it owns, a key it disclaims falls through to the engine's, and directory-level selection alone would make every engine concept unreachable from any repository owning a library},
  check   = {claim:concept-shareable}
}
