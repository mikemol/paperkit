load("//tools:calc.bzl", "pk_pyc", "pk_wheel")
load("//paperkit:dag.bzl", "IMPORTS")
load("//paperkit:components.bzl", "COMPONENTS")

# The engine — EXPLICIT srcs (no globs), DERIVED from the component partition (Μ·kernel·bounds,
# paperkit/components.bzl) so the union is total by construction; boundaries_components.py guards
# disjointness, coverage of the real tree, and the allowed import DAG.  Every project's gate deps
# on //paperkit:engine.  The list is shared by the filegroup AND exports_files, so each module is
# also referenceable as //paperkit:<module>.py — the per-module unit pk_pyc compiles to a .pyc
# build artifact (Ζ·pyc).
ENGINE_SRCS = sorted([f for fs in COMPONENTS.values() for f in fs])

filegroup(
    name = "engine",
    srcs = ENGINE_SRCS,
    visibility = ["//visibility:public"],
)

# Μ·kernel·bounds — one filegroup per component: the ownership unit Μ·kernel·certs certifies and
# the staging unit Μ·kernel·cells scopes Δ inputs to (component cones instead of the flat engine).
[
    filegroup(
        name = "comp-" + c,
        srcs = fs,
        visibility = ["//visibility:public"],
    )
    for c, fs in COMPONENTS.items()
]

exports_files(ENGINE_SRCS)

# Ζ·venv·install — the engine's WHEEL: what a cell INSTALLS the engine from, rather than a .pth
# naming a root that resolves through a symlink into the live tree.  One host-tier action (uv),
# byte-reproducible, keyed on ENGINE_SRCS + pyproject.toml; every cell installs this artifact with
# stdlib zipfile alone.  `library/` is NOT in it (resolver._LIBRARY walks up out of the package —
# the open Ζ·cite·resolve arc), so a `concept:` check still needs the library staged as data.
pk_wheel(
    name = "wheel",
    # ⚑ ENGINE_SRCS ALONE, AND THE FIRST DRAFT ADDED `//tools:files` — which is the OVER-declared
    # half of the glob defect.  A declared input that the output does not depend on does not cause a
    # false green; it busts the cache, and here it would bust EVERY cell's venv on any tools/ edit.
    # Since Ζ·wheel·tools the wheel ships `paperkit` only (pyproject's `packages`), so the honest
    # input set is the engine sources and the metadata that selects them — nothing wider.
    # ⚑ AND THE PACKAGE DATA, WHICH THE HERMETIC BUILD PROVED WAS MISSING.  This staged the .py
    # modules alone and the wheel came out with 26 modules and ZERO library files — setuptools
    # cannot include package data that is not in the tree it builds from.  It had looked right only
    # because `uv` ran UNSANDBOXED against the live checkout, so the library was present by accident
    # of location rather than by declaration: a build reading files it never declared, and passing.
    # bnd-wheel asserts the ARTIFACT's contents precisely so that direction cannot hide.
    srcs = ENGINE_SRCS + ["//paperkit/library:files"],
    pyproject = "//:pyproject.toml",
    visibility = ["//visibility:public"],
)

# Μ·kernel·wire — the partition and the import DAG are FILES as well as loads, so the
# bnd-components guard (staged via //:files) can verify the boundary from the owners.
# ⚑ Ζ·exports·visible — PUBLIC: bib-generated repos are EXTERNAL and exports_files defaults to
# private, so a per-file `builds` label from another repo cannot see these without it.
exports_files(["components.bzl", "dag.bzl"], visibility = ["//visibility:public"])

# Ζ·pyc·engine — the engine's COMPILED form: one pk_pyc per module (one .cc → one .o), so editing a
# module recompiles only its .pyc.  The output preserves the module's path (tests/_fixture_model.py →
# tests/_fixture_model.pyc), so a consumer maps it to __pycache__/<stem>.<tag>.pyc by parallel structure.
# //paperkit:pyc mirrors //paperkit:engine — the bytecode the engine runs off (pk_eval now; the gate
# and checks at Ζ·pyc·run).  Compile ONCE, shared across the whole def-sweep fanout.
#
# Ξ·dag·build — each pk_pyc's deps ARE its imports (paperkit/dag.bzl, AST-derived): the build DAG is a
# projection of the engine import DAG, so a consumer stages a module's transitive .pyc CLOSURE (its
# dependency cone), not the flat engine.
#
# ⚑ Ξ·dag·dotted — THE STEM→TARGET MAP IS GONE, BECAUSE BOTH SIDES OF AN EDGE NOW NAME ONE NAMESPACE.
# IMPORTS used to record a path-shaped KEY against a bare-stem VALUE, so this file translated:
#
#     _STEM_TO_TARGET = {m.rsplit("/", 1)[-1][:-len(".py")]: m[:-len(".py")] for m in ENGINE_SRCS}
#
# A dict comprehension keyed on bare stem is silently LAST-WINS, and the engine spans three
# directories (., tests, tools) flattened into that one key space — measured, 79 sources and 79
# distinct stems, so no collision TODAY and nothing that would refuse one.  A second `bib.py` under
# tests/ would collapse onto paperkit/bib.py's key and the loser's .pyc would never be staged for
# anything importing it: a ModuleNotFoundError inside a sandboxed cell, the shape components.bzl
# records costing four batch runs.  A naming convention with no owner is guard-must-not-copy at the
# build layer.
#
# tools/dagderive.py now records the imported module's PATH — already the shape of a target — and
# REFUSES an ambiguous stem rather than picking one.  Verified a pure rename before landing: 114
# edges before, 114 after, identical once the value spelling is normalised.
[
    pk_pyc(
        name = m[:-len(".py")],
        src = m,
        deps = [":" + s[:-len(".py")] for s in IMPORTS.get(m, [])],
        # Ξ·dag·eval — public: a cell's `closure` references these pk_pyc targets directly (not the
        # flat //paperkit:pyc), and the emerge grid lives in a separate repo.
        visibility = ["//visibility:public"],
    )
    for m in ENGINE_SRCS
]

filegroup(
    name = "pyc",
    srcs = [":" + m[:-len(".py")] for m in ENGINE_SRCS],
    visibility = ["//visibility:public"],
)
