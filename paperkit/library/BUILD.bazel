# Hand-maintained file manifest (Ζ·sunset) — a data dep of the Ζ·starlark-generated
# @paperkit_library check graph.  The concept-witness LIBRARY: it owns each concept's
# witness (concepts.py) and grades it once, exporting the certificate views import.
filegroup(name = "files", srcs = [
        "concepts.py",
        # ⚑ Ζ·entry·point — the witness's ENTRY POINT, named by paper.toml's `[checks.claim] cmd`.
        # A cell runs the declared command, so an unstaged entry point is a check that cannot start:
        # the file is on disk, the declaration points at it, and the sandbox has neither.  Third
        # instance of this class today (tools/dagnames.py, boundaries_closure_census.py) — a file a
        # manifest does not name is invisible to the build, and the failure surfaces far from the
        # cause.
        "run-witness",
        # Ζ·library·kernel — prove/routes/checkcache/labelmap/conclusiongate moved to the
        # ENGINE (paperkit/), where they belong: they are concept-library MECHANISM, not this
        # library's content, and every project's `concept:` resolution goes through them.  As
        # library-local files they were invisible to closure.py (which enumerates engine
        # modules), so the per-claim grid staged a closure without them and concept-views'
        # ∅-baseline flipped.  They now stage with the engine, for every consumer.
        "concepts.bib",
        "paper.toml",
        "rubric.tsv",
        "library.md",
    ], visibility = ["//visibility:public"])

# ⚑ Ζ·exports·visible — paper.toml AS A VISIBLE LABEL, so a witness in a bib-generated EXTERNAL
# repo can depend on THIS FILE rather than on this package's whole filegroup.  exports_files
# defaults to PRIVATE; a filegroup here already declares visibility=public, and the export did
# not, which is why the twelfth gate attempt died in analysis rather than on a claim.
exports_files(["paper.toml"], visibility = ["//visibility:public"])
