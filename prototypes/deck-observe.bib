  claim   = {Ρ·deck·genre·knob surfaced the registry as --genre with --observe, and the interesting part is what it could NOT reuse --- config.Param carries a `choices` tuple validated at resolve time, which is exactly wrong for an OPEN per-project set: a static tuple would either freeze the registry or duplicate and drift from it, so choices is left None and validation routes through genre.resolve, the same reason a check TYPE is validated by the resolver rather than enumerated in a Param.  The completeness guard then caught both consumers (gate and discriminate compose their registries from their import cone) --- the flags would otherwise have been silently ignored},
  rests-on = {collection-runs-the-other-way, registry-landed}
}

@misc{materialize-or-the-deck-is-less-honest,
  section = {remaining}, from = {the-partition-relabels-but-does-not-merge},
  claim   = {Ρ·deck·materialize closed the last inversion --- the observed route's first carrier dumped raw claim text while the transform route ran source.cite_split and earned a verification marker per claim, so the deck sourced from the VERIFIED DAG stated LESS provenance than the reflowed prose; units now carry the same marker derived from each claim's own check type (85 of them on paper/), and the gate refuses a deck without them, since an artifact closer to the proof that says less about it inverts the reason for building the route},
  rests-on = {the-partition-relabels-but-does-not-merge, route-carries-units}
}

@misc{the-segmentation-gets-its-own-drift-gate,
  section = {remaining}, from = {materialize-or-the-deck-is-less-honest},
  claim   = {Ρ·deck·observe·gate gave the segmentation the hold the prose already had --- the deck-correspondence check compares two things computed in the same breath, so it cannot catch the units drifting from the claim-DAG (both sides move together); the units are now COMMITTED as a manifest and regenerated fresh, and re-sectioning a single claim moves the cut and fails the check.  The MANIFEST rather than the .odp is the gated artifact, because a binary two toolchain runs need not reproduce byte-for-byte would gate the toolchain instead of the projection --- the deck is then held to the manifest, so the chain closes claims to units to slides},
  rests-on = {materialize-or-the-deck-is-less-honest, route-carries-units}
}

@misc{merge-made-gamma-structural,
  section = {remaining}, from = {the-partition-relabels-but-does-not-merge},
  claim   = {Ρ·deck·partition·merge closed the bound the previous rung stated --- adding a MERGE of two grounded-adjacent groups beside the relabelling move makes gamma control cardinality, measured on paper/ as 15 groups at gamma=4 (pure sigma, nothing moved) against 11 at gamma<=1, where before it was 15 at every gamma; the staged cut went from 15 units to 11, so the derived grouping now differs from the authored one in COUNT and not only in membership.  Adjacency is the restriction that matters: merging unconnected groups would fuse a document on no evidence},
  rests-on = {the-partition-relabels-but-does-not-merge}
}

@misc{the-declared-half-is-open-in-fact,
  section = {genre}, from = {the-knob-could-not-use-choices},
  claim   = {Ρ·deck·genre·cmd made the open half open in FACT rather than in principle --- the registry recorded a declared genre's cmd and nothing ran it, so a consumer could register an objective it could not use; the engine now invokes it on the `cmd:` model (groups in on stdin, units out on stdout, the format the CLI already prints) and holds the result to the SAME totality invariant a built-in meets, verified against a declared objective that drops a claim and one that exits non-zero --- both refused, because what a pagination IS does not depend on who wrote it},
  rests-on = {the-knob-could-not-use-choices, registry-gates-the-seam-in-four-directions}
}

@misc{units-carry-the-full-materialization,
  section = {remaining}, from = {the-segmentation-gets-its-own-drift-gate},
  claim   = {and a unit now carries everything the PROSE route materializes for its claims, not just their sentences --- an emitted table, image, code block or raw include (rendered by the projector's OWN emit_block, so the two views cannot diverge), a proof-step depth, an expound-rung link, and the check that supplies provenance; a deck dropping those would be a LOSSY view of one carrier and the render layer could not recover what the projector discarded, so the gate now refuses a deck whose placed assets did not reach it, checked against the asset's own text rather than a count},
  rests-on = {the-segmentation-gets-its-own-drift-gate, materialize-or-the-deck-is-less-honest}
}

@misc{three-projects-observe-not-one,
  section = {sweep}, from = {the-remaining-two-were-not-gaps},
  claim   = {Ρ·deck·units·sweep found observe() runs on ALL ELEVEN projects and widened the manifest gate from one to three --- the densest grounded cut, a SECOND grounded project so the gate is not a single instance, and a DEGENERATE one (nine units, nine placed assets, no rests-on) whose partition falls back to its authored sections, exercising a path the grounded projects never reach; the asset-heavy projects turn out to be the degenerate ones, so the case a deck gains most from is exactly the case the grouping can say least about},
  rests-on = {the-remaining-two-were-not-gaps, units-carry-the-full-materialization}
}

@misc{gamma-became-a-knob,
  section = {genre}, from = {merge-made-gamma-structural},
  claim   = {Ρ·deck·gamma·declare made the resolution dial reachable --- gamma was a constant inside each registry entry, so a document could only be re-cut by picking a genre that happened to carry the value wanted; it is now a knob resolving through the same arg-over-env-over-config pipeline as every other, defaulting to NONE so that absence means "whatever the genre asks for" rather than an engine-wide constant silently overriding every genre's declared resolution.  Measured: the staged cut gives 11 units at the genre default and 15 at gamma=4, which is the authored sections recovered},
  rests-on = {merge-made-gamma-structural, the-knob-could-not-use-choices}
}

@misc{the-new-machinery-grades-behavioral,
  section = {remaining}, from = {units-carry-the-full-materialization},
  claim   = {Ρ·deck·observe·adequacy turned the grader on this arc's OWN checks, which had gone ungraded through nineteen rungs of building a system for grading checks --- all fourteen new claims grade BEHAVIORAL, the strongest non-imported rung, so each is proven falsifiable by a single-file mutation rather than merely passing; the def-resolution sweep proved too slow to sit in the loop, killed after minutes on ONE claim, while file resolution answered every claim in seconds --- which is itself the reading: the precise instrument is an on-demand pass, not the one to reach for when the question is whether a check was graded at all},
  rests-on = {units-carry-the-full-materialization}
}

@misc{the-honest-order,
  section = {remaining}, from = {genre-is-the-genuine-blocker},
  claim   = {THE ORDER, stated so it cannot be misread as a roadmap of equal rungs: node is DONE and bounded; residual is DONE, gateable, and independently useful; emit is DONE and walks the route; genre's SHAPE is decided (open registry) while its objective FUNCTIONS are unwritten; observe is DESIGNED and now blocked on those functions rather than on a vocabulary question.  The one thing that must NOT happen is observe landing by quietly widening the slide transform into a target and letting the deck bound be deleted rather than rewritten --- which is exactly the move rnd-deck-bound exists to make impossible},
  rests-on = {genre-is-the-genuine-blocker, the-bound-is-the-landing-trigger, gate-needed-discharge-first}
}
