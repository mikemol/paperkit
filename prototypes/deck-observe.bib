  rests-on = {genre-is-open}
}

@misc{open-does-not-resolve-the-objectives,
  section = {genre}, from = {open-registry-has-a-known-shape},
  claim   = {but OPEN answers only slides.bib's open-gamma-set, NOT its open-objective-per-genre --- deciding that any consumer may register a pagination objective says nothing about what the objective FUNCTIONS are, and the built-in ones still have to be written; the registry decision makes that tractable rather than smaller, since a wrong built-in objective is now correctable by a consumer registering a better one instead of being frozen into a closed enumeration},
  rests-on = {open-registry-has-a-known-shape}
}

@misc{open-shifts-the-gate-question,
