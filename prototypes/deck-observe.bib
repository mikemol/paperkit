@misc{genre-is-open,
  section = {genre},
  claim   = {RESOLVED (owner, 2026-08-22): the genre set is OPEN, a registry on the check-verb model, not a closed enumeration on the paragraph model --- slides.bib's open-gamma-set weighed a two-valued `paragraph` precedent against a genre-is-a-reusable-named-cost reading and could not settle it from inside; the decision is that decks have visibly more genres than prose and a consumer must be able to register its own pagination objective without editing the engine, exactly as a domain registers a check type in its own paper.toml}
}

@misc{open-registry-has-a-known-shape,
  section = {genre}, from = {genre-is-open},
