% deck-observe.bib — Ρ·deck·observe: what remains between the SLIDE FORMAT (landed) and a deck
% that is a PROJECTION of the claim-DAG (not built).
%
% Stored as a paperkit bib for the same reason slides.bib is: the reasoning about a rendering
% surface, kept in the format that surface projects.  DRAFT — no `check` fields: these are DESIGN
% claims, not gated warrants (prototypes/README.md's lifecycle: it earns checks when it lands).
%
% This file is the SUCCESSOR record to slides.bib, written after Ρ·deck·node landed.  slides.bib
% worked out the coalgebra; this one states what node DID and did NOT deliver, and what the
% remaining rungs actually depend on.  Read the DAG (follow rests-on), not the file order.
%
% Session: 2026-08-22.

@misc{node-landed-the-format,
  section = {landed},
  claim   = {Ρ·deck·node LANDED the slide FORMATS: pptx and odp are format OBJECTS in the render coalgebra (graph.py), md-to-pptx is a pandoc morphism, pptx-to-odp an office morphism, and SLIDE_ROUTES composes them --- so `graph.py --check` gates that every declared slide edge's tool is present and every slide route composes real edges, exactly as it does for the pdf routes}
}

@misc{node-did-not-land-the-observation,
  section = {landed}, from = {node-landed-the-format},
  claim   = {but node did NOT land a deck PROJECTION --- every slide edge is a downstream TRANSFORM of the pandoc observation of an already-linearized document, so the content reaching a slide is prose that has ALREADY lost the DAG structure; this is precisely the exporter-of-finished-prose that slides.bib's docx-pdf-are-transforms-not-observations names as the trap},
  rests-on = {node-landed-the-format}
}

@misc{the-bound-is-gated-not-noted,
  section = {landed}, from = {node-did-not-land-the-observation},
  claim   = {the distinction is GATED rather than left as a comment --- rnd-deck-bound (render/checks/deck_bound.py) asserts both halves: the slide objects really are first-class in the coalgebra (the positive half), AND no slide format appears in project.TARGET.choices (the falsifier).  So the sentence "a deck projected from the DAG remains unbuilt" is a claim that CAN become false: the moment someone adds a slide target to the projector, the bound goes red and must be honoured or rewritten},
  rests-on = {node-did-not-land-the-observation}
}

@misc{the-bound-is-the-landing-trigger,
  section = {landed}, from = {the-bound-is-gated-not-noted},
  claim   = {and that falsifier is not merely a guard but the LANDING TRIGGER for observe --- the check is designed to go red exactly when Ρ·deck·observe lands, at which point the correct move is to REWRITE the claim and the check together, not to weaken either; a bound that can only be satisfied by never building the thing would be a bound on the roadmap, not on the artifact},
  rests-on = {the-bound-is-gated-not-noted}
}

@misc{residual-landed-independently,
  section = {measure},
  claim   = {Ρ·deck·residual LANDED as coherence.py's FIFTH face (grouping_residual) --- the authored section partition sigma checked against P* = argmax_P [Q_E(P) - gamma*d(P,sigma)] over the rests-on graph, reported as d(sigma,P*) plus the NAMED claims that move.  It reads only the bib, no sweep, so it measures wherever a project parses --- which is why it was buildable before observe and useful independently of decks}
}

@misc{residual-calibrated-against-an-outside-arm,
  section = {measure}, from = {residual-landed-independently},
  claim   = {the measure agrees with an INDEPENDENT prior measurement --- slides.bib's measured-grounding-is-sparse-and-section-aligned recorded 57 rests-on edges and 61 percent within-section on the paper project from a separate analysis, and the implemented face, run on the paper AS IT STOOD AT THAT COMMIT, reported exactly 57 edges and 61 percent; a relative instrument built only of comparisons cannot detect a uniform bias in its own primitive, so agreeing with a value fixed OUTSIDE the instrument is the calibration that mere internal consistency could not supply.  The live numbers MOVE as claims are added (adding this arc's own grouping-residual claim took them to 58 edges and 62 percent, and surfaced a fifth named claim) --- which is the point: the calibration is a fixed historical agreement, not a constant the document must hold},
  rests-on = {residual-landed-independently}
}

