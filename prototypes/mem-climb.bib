@misc{bazel-has-no-per-action-limit,
  section = {blocker},
  claim   = {MEASURED (bazel 8.7, 2026-08-22): resource_set is a SCHEDULING hint, not a ceiling --- it tells Bazel how many actions may run at once and never bounds any one of them --- while --experimental_sandbox_memory_limit_mb sets memory.max on every action's cgroup from ONE build-wide value, so Bazel can enforce a limit but cannot give each cell its own}
}

@misc{no-event-to-climb-on,
  section = {blocker}, from = {bazel-has-no-per-action-limit},
  claim   = {so under paperkit's current configuration a cell CANNOT OOM from its own reservation --- .bazelrc sets the limit to HOST_RAM, and exceeding a reservation merely oversubscribes the box, which manifests as whole-machine thrash rather than a per-cell kill; the climb loop has no attributable event to climb on, and the discriminator would have nothing to read},
  rests-on = {bazel-has-no-per-action-limit, discriminator-is-the-content}
}

