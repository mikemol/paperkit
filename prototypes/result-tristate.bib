% result-tristate.bib — the design DAG for ask-result-tristate (summit, open against paperkit).
%
% NOT a value fork (three states) but a TYPING fork: resolves() should be Π-typed — a dependent
% function whose result type is indexed by WHICH VERB resolved it, each verb delegating to the
% OWNER of its semantics, never scalar-collapsing at the boundary. The tristate is the degenerate
% scalar shadow of the real thing. Design-first (the shape converges on the floor, not here);
% rests-on the exit-alphabet work landed this session and the pi-typed-delegation memory.
% Session 2026-08-15. No check fields (design claims, graded indeterminate until built).

@misc{the-fold-is-a-scalar-collapse,
  section = {problem},
  claim   = {resolver.resolves returns a bare bool and folds EVERY verb's outcome AND every exception into it (three except-Exception:return-False sites). This loses two things at once: the three states (available / pass / fail --- the ask's framing) AND which KIND of thing answered. In-repo harmless (nine sibling projects always present); across repositories it reports a fact about the METHOD (I could not reach it) as a fact about the WORK (it failed)}
}

@misc{tristate-is-still-a-sum-type,
  section = {problem}, from = {the-fold-is-a-scalar-collapse},
  claim   = {a tagged tristate (available|pass|fail) is BETTER but still a SUM type --- it flattens result:-unavailable and concept:-unavailable and cmd:-unavailable into one `unavailable`, when those are DIFFERENT unavailabilities owned by DIFFERENT resolvers. The sibling project being unable to run, the library not owning a key, and a shell tool being absent are three distinct facts with three distinct owners. A single `unavailable` tag re-collapses them one level up},
  rests-on = {the-fold-is-a-scalar-collapse}
}

@misc{the-answer-is-pi-typed,
  section = {design}, from = {tristate-is-still-a-sum-type},
  claim   = {THE SHAPE (user, 2026-08-15): the right solution looks like the concept library and parameterizable witnesses --- Pi types all the way down. resolves is a DEPENDENT FUNCTION: its result TYPE is indexed by which verb resolved it, and each verb's resolver returns ITS OWNER's evidence (the sibling's available/pass/fail from gate --json; the library's not-mine/pass/fail from the exit-2 sentinel; the shell's tool-absent/ran), delegated to the owner of that verb's semantics. Stop scalar-collapsing at the boundary; dispatch on ownership all the way down. This is pi-typed-boundary-delegation (grade a cross-boundary dependency by DELEGATION to its owner, dispatch on OWNERSHIP) applied to the resolver itself}
}

@misc{crosses-is-already-the-index,
  section = {design}, from = {the-answer-is-pi-typed},
  claim   = {the Pi-index ALREADY EXISTS: VERBS carries `crosses` (resolver.py:74-95) --- the STRUCTURAL bit saying whether a verb crosses a boundary, stored as data precisely so every site derives from it. And the dispatch is HALF-BUILT: concept: already does per-OWNER sentinel dispatch (exit 2 = "not mine", fall through to the true owner, Λ·library·fallthrough); result: already READS the sibling's own typed exit (gate --json, which since the exit-alphabet work emits available/pass/fail). Both reach the owner and get a typed answer --- then BOTH collapse it to bool at the return. The engine computes the ownership-typed evidence and flattens it on the way out},
  rests-on = {the-answer-is-pi-typed}
}

@misc{the-fix-is-stop-the-flatten,
  section = {design}, from = {crosses-is-already-the-index},
  claim   = {so the fix is NOT to invent a tristate --- it is to STOP THE FLATTEN. Let each verb's resolver return its owner's evidence, typed by which verb answered; let resolves be the dependent function that dispatches on the verb (crosses and beyond) to the right owner's evidence-type. The tristate (available/pass/fail) is the degenerate SCALAR SHADOW projected when a consumer needs a flat answer; the real return is the Pi-type. A consumer that only wants pass/fail projects the shadow explicitly (a named local collapse), never a hidden one},
  rests-on = {crosses-is-already-the-index, rests-on-the-exit-alphabet}
}

@misc{rests-on-the-exit-alphabet,
  section = {design},
  claim   = {this rests on the typed-gate-exit work landed this session (gate.py a7f9909): the gate ALREADY emits 0 pass / 1 ran-and-failed / 3 cannot-run + --json.available. So the sibling a result: check imports ALREADY reports available-vs-failed through the typed exit; the resolver is the one consumer still discarding it. The gate types it; the resolver must propagate it. Without the exit-alphabet this ask would need the gate typed first --- it isn't blocked, it's UNBLOCKED, by prior work}
}

@misc{delta-is-the-first-consumer,
  section = {consumers}, from = {the-fix-is-stop-the-flatten},
  claim   = {resolves() has 5 consumers: gate.py (verdict, x2) and grader.py's Δ sweep (x4: baseline, flip, repeat-determinism). The Δ sweep asks a DIFFERENT question --- "does mutating this flip the check" --- where "unavailable" has a SPECIFIC meaning: an unavailable premise CANNOT BE FLIPPED, which is exactly the unfalsifiable-component hole ask-delta-extensionless names. So the resolver's new unavailable state is the INPUT the Δ mutation surface needs to stop folding immutable-data and cant-mutate into one False. This is the dependency edge: result-tristate must land BEFORE delta-extensionless, because it hands delta-extensionless its type},
  rests-on = {the-fix-is-stop-the-flatten}
}

@misc{design-first-not-unilateral,
  section = {process}, from = {the-fix-is-stop-the-flatten},
  claim   = {this is a CORE CONTRACT every consumer AND every downstream repo reads (the ask recurs because every boundary-crossing verb currently scalar-collapses --- it is the most-frequently-hit shape across repos). The ask is EVIDENCE, not a spec. So the shape converges on the FLOOR, not unilaterally in resolver.py: put the Pi-typed framing to summit (like the per-edge-trust RFC), confirm the crosses-index and per-owner-evidence shape with the consumers, THEN build. Coding resolver.py now would propagate a guessed fold instead of fixing the class},
  rests-on = {the-fix-is-stop-the-flatten}
}

@misc{open-what-is-the-evidence-type,
  section = {open},
  claim   = {OPEN: what EXACTLY is each verb's owner-evidence type? result: = the sibling's {available, pass, gaps} (already in gate --json). concept: = {owned?, pass} (the exit-2 sentinel + verdict). cmd: = {tool-present?, exit} (Τ·path territory --- a tool absent is unavailable, not fail). file: = probably degenerate (present|absent, no unavailable arm). agree: = per-producer {present?, concurs}. Are these ONE parameterized shape (family/argument, like Λ·key·graded) or genuinely distinct per-verb records? The parameterizable-witness precedent says try the family first. Unresolved --- no witness yet},
  rests-on = {the-answer-is-pi-typed}
}

% ── corroboration (mat230, 2026-08-15): measured from its consumer AND provider code ──

@misc{mat230-datum-the-arm-not-the-index,
  section = {corroboration},
  claim   = {mat230 --- the one consumer that hit the bare-bool across a REAL repo boundary --- answered from its code: a FLAT tristate (available|pass|fail) would have been enough. It needed the `available` ARM and never the Π-typed per-owner INDEX; both its boundaries collapse all unavailability into one bucket and never route on which owner produced it. So the record separates NECESSARY from VALUE: the third ARM is load-bearing (a consumer that lacks it is forced to fake it); the per-owner INDEX is genuine value for OTHER consumers, not one mat230 would have exercised. This REFINES the design --- do not present the index as THE fix; the arm is the fix, the index is separable improvement},
  rests-on = {tristate-is-still-a-sum-type, the-answer-is-pi-typed}
}

@misc{mat230-faked-the-arm-both-directions,
  section = {corroboration}, from = {mat230-datum-the-arm-not-the-index},
  claim   = {the EVIDENCE is stronger than the answer: lacking the arm, mat230 faked it at BOTH boundaries in OPPOSITE directions. CONSUMER (coursework.py:_gate_state) reconstructs available-vs-not by SCRAPING bin/pk gate stdout for marker strings; no marker → None = "gate did not really run", kept distinct from ran-and-not-green so an absent gate never overrides a user's done-mark --- the availability fact was not in the signal, so it was reconstructed from TEXT. PROVIDER (agda_check.py, a [checks.agda] verb the resolver calls) has exit {0 pass, 1 fail, 2 usage}, NO cannot-run arm, so it folded "toolchain absent" into exit 0 (pass) + a loud stderr SKIP note --- resolver:226's hazard from the other side, paid by making "unverified" legible only in text, invisible to any exit-code reader: a machine sees green and cannot tell verified from skipped},
  rests-on = {mat230-datum-the-arm-not-the-index}
}

@misc{version-skew-bites-both-ways-inconsistently,
  section = {corroboration}, from = {mat230-faked-the-arm-both-directions},
  claim   = {THE SHARPEST BIT, and it corroborates version-skew-as-silent-refutation concretely: agda_check folds the TWO flavours of unavailable into DIFFERENT wrong arms --- a missing Agda BRIDGE file → exit 1 (fail), a missing agda BINARY → exit 0 (pass). Same "can't check this", split across BOTH wrong arms by a hand-picked which-is-safer-default judgement, INCONSISTENT within one file. That is "three facts with three owners, flattened" made concrete --- and VERIFIED at agda_check.py (summit read the file, paperkit re-verified): the SKIP-green (:45, missing binary -> exit 0) is DOCUMENTED DELIBERATE POLICY in the docstring (:9-11, 'so a machine without the toolchain does not red the gate'), while the missing-bridge case (:38 -> exit 1) is UNEXAMINED, treated as an ordinary input-absent failure. So it is stronger than arbitrary defaults: one cannot-run case was considered and the other accidental, ten lines apart, self-inconsistent within one careful author's one file, BECAUSE THE EXIT TYPE OFFERED NOWHERE TO PUT CANNOT-RUN. A missing arm does not merely produce arbitrary defaults; it makes CAREFULNESS INSUFFICIENT --- the author who reasoned about one instance still got the other backwards because the type had no inhabitant for the distinction. It does NOT require routing on owner --- give it a cannot-run arm and both flavours return it and the inconsistency vanishes; mat230 would not care which owner. Hence "the arm, not the index"},
  rests-on = {mat230-faked-the-arm-both-directions, the-fix-is-stop-the-flatten}
}

@misc{the-one-forced-inhabitant,
  section = {corroboration}, from = {version-skew-bites-both-ways-inconsistently},
  claim   = {the one inhabitant the Π-design MUST carry, from this datum: cannot-run must be reachable WITHOUT the consumer knowing which owner could not run --- the unknown-verb inhabitant already flagged (resolver:226) is exactly it. So the design's minimal core is: (1) a cannot-run ARM, owner-agnostic, always reachable (closes mat230 and every arm-only consumer, eliminates BOTH fakes --- the consumer text-scrape and the provider skip-green-with-note); (2) the per-owner INDEX as a REFINEMENT the arm-only consumer projects away. The Π-type is the general shape; the flat-tristate-with-a-real-cannot-run-arm is its degenerate-but-sufficient shadow for a consumer that does not route on owner. Both close the ask's witness},
  rests-on = {version-skew-bites-both-ways-inconsistently, open-what-is-the-evidence-type}
}

@misc{ship-the-arm-let-the-index-earn-its-place,
  section = {corroboration}, from = {the-one-forced-inhabitant},
  claim   = {SEQUENCING (summit, from mat230's narrower requirement): the ask and the design now have cleanly DIFFERENT scopes. ask-result-tristate needs only the ARM --- its witness asserts only that resolves() stops returning a bare bool and stops folding exceptions into False, which an owner-agnostic cannot-run arm closes. The Π INDEX is a SEPARATE proposition with, so far, ZERO measured consumers (mat230 explicitly did not exercise it). This is not an argument against the index --- it is an argument to SHIP THE ARM without waiting for the index to be justified, and let the index earn its place from substrate's answer (the consumer most likely to route on WHICH owner, given it consumes paperkit as a CLI from an external checkout) or a later one. The respondent who FILED the ask returned a NARROWER requirement than the answerer's design --- a boundary, not a decline or a rubber stamp --- which is the honest way scope gets set},
  rests-on = {the-one-forced-inhabitant, design-first-not-unilateral}
}
