% slides-proposal.bib — the claim-DAG for the slide/collection projection design.
%
% Stored AS A PAPERKIT BIB on purpose: the reasoning about a rendering surface, kept
% in the format that surface projects. Self-describing (the argument-DAG-in-a-bib case).
% DRAFT: no `check` fields yet — these are DESIGN claims, not gated warrants. The
% `rests-on` edges encode the actual logical dependencies of the proposal, so this file
% is itself an instance of the thing it proposes (a slide would cut it at these seams).
%
% Session: 2026-08-15, paperkit design conversation on slide decks as a render target.
% Sections trace the argument's own emergent structure (foundation → cut → recursion →
% composition → genre). Read the DAG, not the file order.

% ── foundation: paperkit's projection is already coalgebraic ──────────────────────────

@misc{projection-is-coalgebra,
  section = {foundation},
  claim   = {paperkit's document is not authored but PROJECTED --- an unfold (anamorphism) of the claim-DAG. The carrier is the DAG; project(cfg, target) is the observation; `target` selects the OBSERVATION FUNCTOR (markdown/web/footnote/plain/pandoc), which the projector's own docstring names: only how a citation MATERIALIZES differs by target}
}

@misc{targets-are-total-linearizations,
  section = {foundation}, from = {projection-is-coalgebra},
  claim   = {every EXISTING target unfolds the DAG to ONE flat stream (String) --- a TOTAL LINEARIZATION seeded by rubric-order x dep-order. The gate's PROJECT invariant is prose == project(cfg, target), i.e. byte-equality of one committed artifact against one projection},
  'rests-on' = {projection-is-coalgebra}
}

@misc{docx-pdf-are-transforms-not-observations,
  section = {foundation}, from = {targets-are-total-linearizations},
  claim   = {docx and pdf are NOT new observations of the DAG --- they are downstream TRANSFORMS of the pandoc observation (pandoc then LibreOffice). So an exporter-of-finished-prose would make a deck a second-class artifact that has ALREADY lost the DAG structure; observing the DAG directly is what keeps rests-on as build-order},
  'rests-on' = {targets-are-total-linearizations}
}

% ── the cut: slides break the linearization invariant ─────────────────────────────────

@misc{slides-break-linearization,
  section = {cut}, from = {targets-are-total-linearizations},
  claim   = {a slide deck is NOT a linearization --- it is a SEGMENTATION into a sequence of bounded observation-windows, each showing a SUBSET of the DAG. So the observation type changes: not S -> String but S -> List(Slide), where Slide is itself a bounded observation of a sub-DAG},
  'rests-on' = {targets-are-total-linearizations}
}

@misc{cut-is-derived-refined-by-declared,
  section = {cut}, from = {slides-break-linearization},
  claim   = {the cut is NOT derived-XOR-declared (a false fork). Like a word processor: DERIVED pagination by default, a manual Ctrl-Enter override the flow reflows around. The override is a PROJECTION INPUT, not authored content --- the deck stays project(cfg, slides), byte-stable, gate-verified as committed == observation},
  'rests-on' = {slides-break-linearization, depth-is-the-precedent}
}

@misc{depth-is-the-precedent,
  section = {cut},
  claim   = {`depth` ALREADY is the Ctrl-Enter pattern: a DECLARED per-claim field (in _SCALAR beside emit/as/move/link) that annotates rendering (a proof-step nests as an indented list item) WITHOUT reordering --- dep_order still produces the sequence, depth only changes materialization. A `slide = break` field is depth's sibling, one _SCALAR member, honored by the windowing},
  'rests-on' = {}
}

% ── the invariant grouping: emergent from rests-on, not authored ──────────────────────

@misc{grouping-is-recursive,
  section = {grouping}, from = {slides-break-linearization},
  claim   = {a slide is a composite of claims; a chapter a composite of slides; a deck a composite of chapters --- ONE grouping operation applied RECURSIVELY. The coalgebra is S -> RoseTree(S): an anamorphism into a tree (deck > chapters > slides > claims), not three ad-hoc levels},
  'rests-on' = {slides-break-linearization}
}

@misc{grouping-emerges-from-rests-on,
  section = {grouping}, from = {grouping-is-recursive},
  claim   = {EMERGENT (not forced) grouping means the tree's branching comes from a MEASURE on the DAG, not authored fields. The measure is MODULARITY on the reduced rests-on graph: a group boundary falls where grounding-connectivity is WEAKEST (between argument-steps), the way a good page-break falls between paragraphs. This is the ONE genuinely-new primitive --- paperkit has rests-on and its transitive reduction but NO clustering operator today},
  'rests-on' = {grouping-is-recursive}
}

@misc{grade-is-the-prominence-axis,
  section = {grouping}, from = {grouping-emerges-from-rests-on},
  claim   = {a full DAG (~84 claims) cannot be ~84 slides, so a deck may observe a FILTERED carrier. rests-on-modularity gives the GROUPING; effective_grade/centrality gives the PROMINENCE (spine vs detail). The two compose: a slide is a strongly-grounded cluster, low-grade detail falls to speaker-notes/appendix AUTOMATICALLY. Structure from grounding, emphasis from grade, neither authored},
  'rests-on' = {grouping-emerges-from-rests-on}
}

% ── composition <-> decomposition: one operator, two directions ───────────────────────

@misc{carrier-is-a-union-of-a-collection,
  section = {composition},
  claim   = {the carrier was NEVER one document's DAG --- load_config UNIONS a warrants list (12 fragments: F.update(entries(b))) into one graph, and result:/concept: fold a sibling project's graph one level up. The paper is already union(collection). Composition is the primitive; the individual documents are ONE decomposition of the union},
  'rests-on' = {}
}

@misc{compose-decompose-is-an-adjunction,
  section = {composition}, from = {carrier-is-a-union-of-a-collection},
  claim   = {compose (union the fragments) and decompose (cut the union into the collection that best coheres) are the SAME operator run in opposite directions on one carrier. compose is left adjoint to decompose. Today paperkit has the LEFT adjoint FREE (union is structural) and the RIGHT adjoint HAND-AUTHORED (section + rubric are declared, not emergent)},
  'rests-on' = {carrier-is-a-union-of-a-collection, grouping-emerges-from-rests-on}
}

@misc{deck-and-collection-are-two-serializations,
  section = {composition}, from = {compose-decompose-is-an-adjunction},
  claim   = {"decompose into a deck OR a more optimal document collection" is ONE carrier, ONE grouping, two SERIALIZATIONS of the rose-tree: deck flattens a subtree to reveal-order; collection materializes each subtree as a standalone doc (its warrants/rubric DERIVED, not authored). Same decomposition, different observation functor on the tree},
  'rests-on' = {compose-decompose-is-an-adjunction, genre-supplies-pagination}
}

@misc{rubric-becomes-the-override,
  section = {composition}, from = {compose-decompose-is-an-adjunction},
  claim   = {rubric does NOT disappear under emergent decomposition --- it becomes the DECLARED OVERRIDE on the emergent document-cut, exactly as `slide = break` overrides emergent pagination. Author section boundaries where rhetoric wants them; the measure fills the rest. The derive-default/declare-override shape holds all the way up, from paragraph to document},
  'rests-on' = {compose-decompose-is-an-adjunction, cut-is-derived-refined-by-declared}
}

% ── genre: pagination is a named objective, separate from grouping ─────────────────────

@misc{grouping-is-not-pagination,
  section = {genre}, from = {grouping-emerges-from-rests-on},
  claim   = {CORRECTION (2026-08-15): a slide is NOT a rests-on cluster --- that fused two axes. The cluster is the GROUPING (structural, emergent, genre-invariant: what coheres). WHERE a slide break falls is a RHETORIC/GENRE choice ON TOP: the same cluster can be one dense staged slide, N slide-per-claim, or one summary line, chosen by TARGET GENRE. Grouping and pagination are independent axes},
  'rests-on' = {grouping-emerges-from-rests-on}
}

@misc{paragraph-is-the-genre-precedent,
  section = {genre}, from = {grouping-is-not-pagination},
  claim   = {this two-axis shape ALREADY exists one level down: paragraph = woven|claim is a PROJECT-LEVEL genre knob (bib.py) on ONE grouping. `woven` stages a run of claims into one paragraph (= staged bullets on one slide); `claim` gives each its own paragraph (ISO 24495-1, = slide-per-claim). Same grouping, two presentations, chosen by a knob --- not per-claim, not derived},
  'rests-on' = {grouping-is-not-pagination, depth-is-the-precedent}
}

@misc{genre-supplies-pagination,
  section = {genre}, from = {paragraph-is-the-genre-precedent},
  claim   = {the slide coalgebra needs a GENRE parameter, sibling to `paragraph` and `target`, that paginates the emergent clusters: slides = staged (cluster -> one staged-reveal slide, conference talk) | atomic (cluster -> slide-per-claim, teaching) | summary (cluster -> one line, exec brief) | collection (subtree -> standalone doc). The observation functor is now indexed by (target, genre), not target alone},
  'rests-on' = {paragraph-is-the-genre-precedent, grouping-is-not-pagination}
}

@misc{genre-names-the-objective,
  section = {genre}, from = {genre-supplies-pagination},
  claim   = {the genre knob and the "optimal collection" objective function are the SAME choice viewed twice. A genre IS a named objective on pagination (talk = minimise high-load slides; teaching = one concept per unit; brief = maximise coverage per slide; collection = e.g. minimise cross-document rests-on edges --- where the dangling-premise gate becomes the COST function). You do not pick an abstract cost AND a genre; the genre is a reusable named cost, the way paragraph=woven is a reusable named choice},
  'rests-on' = {genre-supplies-pagination, grade-is-the-prominence-axis}
}

% ── terminus: the whole design in one statement ───────────────────────────────────────

@misc{the-slide-coalgebra,
  section = {terminus}, from = {genre-names-the-objective},
  claim   = {THE DESIGN: project was S -> String indexed by `target`; slides make it S -> RoseTree(S) indexed by (target, genre). ONE carrier (the union DAG, already composed). ONE invariant grouping (rests-on-modularity + grade-prominence, EMERGENT). ONE recursive functor cut at a chosen resolution. Genre picks the pagination of the emergent grouping (a named objective). Sparse declared overrides (slide/depth/rubric = the Ctrl-Enter) layer on top. The SOLE new primitive is the rests-on cluster-measure; everything else --- the union, the recursion, grade, the declared-override family, result:/concept: for cross-boundary subtrees, the gate-as-projection --- paperkit already runs},
  'rests-on' = {the-slide-coalgebra-open-questions, genre-names-the-objective, grade-is-the-prominence-axis, deck-and-collection-are-two-serializations, cut-is-derived-refined-by-declared}
}

@misc{the-slide-coalgebra-open-questions,
  section = {terminus},
  claim   = {OPEN (the unforced decisions, none blocking): (1) the rests-on modularity measure's OBJECTIVE --- minimise-cross-edges vs maximise-internal-density vs grade-weighted --- is a knob (the deck-analog of --min-strength), now understood to be NAMED BY GENRE. (2) are the genres a small CLOSED set or open like check-verbs. (3) full DAG vs grade-filtered spine collapses INTO the grouping question (both are "which emergent measure cuts the deck"). None require new architecture; they are the choices the measure and genre leave open},
  'rests-on' = {}
}
