# Hand-maintained file manifest (Ζ·sunset) — a data dep of the Ζ·starlark-generated
# @paperkit_talk check graph; the bib is the source, this just lists the files.
#
# The rendered decks (talk.odp, talk.pptx) are DERIVED and deliberately absent: they are
# projections of this bib, and listing a deliverable as a source input would make the artifact
# an input to its own gate.  No sibling project lists one either.
filegroup(name = "files", srcs = [
        "TALK.md",
        "paper.toml",
        "rubric.tsv",
        "warrants.bib",
        "checks/talk.py",
        "assets/five-verbs.svg",
        "assets/one-concept-many-views.svg",
        "assets/two-edges.svg",
        "assets/two-routes.svg",
    ], visibility = ["//visibility:public"])

# ⚑ Ζ·exports·visible — paper.toml AS A VISIBLE LABEL, so a witness in a bib-generated EXTERNAL
# repo can depend on THIS FILE rather than on this package's whole filegroup.  exports_files
# defaults to PRIVATE; a filegroup here already declares visibility=public, and the export did
# not, which is why the twelfth gate attempt died in analysis rather than on a claim.
exports_files(["paper.toml"], visibility = ["//visibility:public"])
