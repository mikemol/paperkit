@misc{t-delta,
  note = {Pause here. This is the intellectual centre of part one, and it is the objection the sharp person in row three is already forming. Getting there before they do is worth more than any feature slide.},
  section = {how}, move = {concession}, from = {t-graphs}, rests-on = {t-bars}, join = {. },
  claim = {a passing check proves only that a sentence NAMED a verifier, so the checks themselves are graded by mutation --- drop a function body, corrupt an input, and see whether the check flips red; a check that cannot fail grades vacuous and that is a build error, not a review nitpick},
  check = {concept:adequacy-pitch}
}
@misc{t-library,
  note = {If you only have time for one deep example in part one, make it this. Prove once, import everywhere.},
  section = {libraries},
  claim = {a CONCEPT LIBRARY authors and grades a proof ONCE, and every view imports its certificate --- the verdict plus the engine fingerprint it was measured against --- instead of re-authoring a parallel and usually weaker witness},
  check = {concept:concept-builtin}
}
@misc{t-hashcons,
  note = {The distinction that matters: this is not de-duplication after you notice a repeat. By the time you notice, the copies already disagree. Interning is the discipline that prevents the divergence rather than cleaning it up.},
  section = {libraries}, move = {amplification}, from = {t-library}, rests-on = {t-library}, join = {, and },
  claim = {the library is a HASH-CONS table rather than a cache of repeats --- every concept interns to exactly one canonical node, so the test for lifting something in is whether it IS a concept, never whether it has been written twice},
  check = {concept:concept-interned}
}
@misc{t-views,
  note = {The concrete result to quote: a full documented view in this repo has nine claims and ZERO lines of proof code. Every sentence certified by a concept the library had already graded.},
  section = {libraries}, move = {consequence}, from = {t-hashcons}, rests-on = {t-hashcons}, join = {, which lets },
  claim = {one truth carry SEVERAL prose faces --- a pitch, a deep exposition and a tutorial each speak in their own register while importing the identical proof, so the faces cannot drift and a view may add no witness code at all},
  check = {concept:concept-views}
}
@misc{t-library-fig,
