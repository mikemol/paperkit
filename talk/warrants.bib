  section = {formats}, move = {addition}, from = {t-fmt-many}, rests-on = {t-fmt-graph}, join = {. },
  claim = {and presentation AGREEMENT extends the invariant down the stack --- the plain text a reader sees in the rendered document is the plain text of the verified source, so the render cannot quietly misrepresent what was checked},
