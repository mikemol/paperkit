  section = {why}, move = {amplification}, from = {t-time}, rests-on = {t-asymmetry}, join = {, and the bill comes due in four places: },
  claim = {onboarding wrong at step six, an integrator building on a stale spec, a compliance answer someone will hold you to, and a design record describing a system gone two years},
  check = {premise:field-observation}
}
@misc{t-bars,
  note = {This is the promise the rest of both talks has to pay off. Bar four is the unusual one --- write it on the board if you have one. Everything in part two is downstream of it.},
  section = {why}, move = {consequence}, from = {t-bill}, rests-on = {t-time}, join = {. },
