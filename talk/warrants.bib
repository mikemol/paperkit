  claim = {which capability each FORMAT affords is owned as data --- native, only-after-post-processing, or TOOLCHAIN-EXCEPTED, a named exception and never a silent gap --- so a capability's reach is stated in one place and every demonstrated cell names the warrant that shows it},
  check = {concept:capability-owned-as-data}
}
@misc{t-a11y-slides,
