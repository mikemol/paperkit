@misc{t-asymmetry,
  note = {Open by asking for hands: who has followed a README that did not work? Every hand goes up. Then ask whose fault it was --- nobody's. That is the point: there is no mechanism, so care is the only defence, and care does not survive staff turnover.},
  section = {why},
  claim = {ship a wrong line of code and the build goes red in ninety seconds; ship a wrong line of prose and it is served to every new hire, integrator and auditor until someone burns an afternoon on it},
  check = {premise:shared-experience/prose-ships-unchecked}
}
@misc{t-time,
  note = {Say this slowly. Nobody in the room writes a doc intending it to be false. The defect is structural, not moral, and that framing keeps the audience with you rather than defensive.},
  section = {why}, move = {consequence}, from = {t-asymmetry}, join = {. },
  claim = {the failure is not carelessness but TIME --- the sentence was true when written, the system moved, the sentence stayed},
  check = {premise:shared-experience/truth-decays-with-time}
}
@misc{t-bill,
