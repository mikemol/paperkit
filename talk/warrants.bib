  section = {a11y},
  claim = {accessibility becomes a set of GATED CLAIMS rather than an audit --- each Supports in a conformance statement names a check, so a false one is a red build instead of a paragraph nobody re-reads},
  check = {result:render#rnd-wcag-entail}
}
@misc{t-a11y-construct,
