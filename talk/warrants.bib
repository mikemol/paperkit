@misc{t-shareable,
  note = {This is the question people actually care about --- can I reuse someone else's library? Consumer-first with per-key fallthrough is the answer: your library wins for keys you own, and you still reach the shared ones you do not.},
  section = {libraries}, move = {scope-shift}, from = {t-views}, rests-on = {t-library}, join = {. },
  claim = {libraries are SHAREABLE across projects because the seam resolves consumer-first with per-key fallthrough --- your own library answers the keys it owns, and a key it disclaims falls through to the engine's, so a downstream repository keeps its own concepts without losing access to the shared ones},
  check = {concept:concept-shareable}
}
@misc{t-compose,
  note = {Delegation is the load-bearing word. The importing side does NOT re-sweep the proof, because re-deriving it would measure the same thing twice while claiming independence --- and could disagree with the owner.},
  section = {libraries}, move = {scope-shift}, from = {t-shareable}, rests-on = {t-verbs}, join = {. },
  claim = {projects CITE EACH OTHER through exactly two boundary-crossing imports --- a verdict import takes a sibling's whole gate result, a certificate import takes one graded concept --- and both DELEGATE adequacy to the owner rather than re-deriving it},
  check = {concept:imported-grade}
}
@misc{t-chain,
  note = {Demo this live if the room is technical: break the innermost project and watch the outermost go red. It takes fifteen seconds and it makes transitivity concrete.},
  section = {libraries}, move = {amplification}, from = {t-compose}, rests-on = {t-compose}, join = {, and they },
  claim = {CHAIN: a project may rest on a sibling that rests on a third, so a verdict carries the whole cone beneath it and a family of projects is one claim-DAG at a coarser grain --- break the innermost and the outermost goes red},
  check = {claim:t-chain}
}
@misc{t-a11y-claim,
