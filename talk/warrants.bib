@misc{t-claim,
  note = {The whole talk in one slide. If someone is only half-listening, this is the sentence to land. The bib file is not metadata about the paper --- it IS the paper.},
  section = {how},
  claim = {so write CLAIMS, not prose --- one bibliography entry per claim carrying a sentence, its section, what it depends on, and a machine verifier; the document is the DAG's projection, generated and never hand-authored},
  check = {concept:rm-pitch}
}
@misc{t-commands,
  note = {Note that PROJECT is subtler than regenerate: it proves the COMMITTED, reviewable markdown is the one the claims produce, so you keep normal PR review. Coverage running both ways blocks the cheap dodge of quietly dropping an inconvenient claim.},
  section = {how}, move = {consequence}, from = {t-claim}, rests-on = {t-claim}, join = {. },
  claim = {two commands do the work --- project turns the claims into the document, gate verifies it --- and three invariants hold: the committed prose equals its projection, every cited claim's check passes, and every section is covered both ways},
  check = {concept:rm-cmds-inv}
}
@misc{t-verbs,
  note = {Someone will ask about escape hatches --- get there first. cmd: is deliberately universal, and that is a trust posture, not an oversight: gating a document RUNS it, so a warrant set is trusted code like a makefile.},
  section = {how}, move = {amplification}, from = {t-commands}, rests-on = {t-commands}, join = {. },
  claim = {a verifier is named type:target and five verbs ship built in --- file EXISTS, cmd EXECS, result PARSES a sibling project's verdict, agree CONCURS across independent producers, and concept IMPORTS a certificate --- while cmd is the universal escape hatch every check reduces to, so a new domain adds named types in its own config without touching the engine},
  check = {concept:rm-resolver}
}
@misc{t-graphs,
  note = {The payoff sentence: a paper can be all-green on every individual check and still be honestly reported as weak, because its thesis inherits the grade of the weakest thing it rests on. No human volunteers that about their own paper.},
  section = {how}, move = {scope-shift}, from = {t-verbs}, rests-on = {t-claim}, join = {. },
  claim = {two edges, not one: `from` sets prose order and connective glue, `rests-on` sets GROUNDING --- and conflating them lets a well-structured argument hide a weak foundation, since a claim is never stronger than its weakest premise},
  check = {concept:edge-rests-grounds}
}
