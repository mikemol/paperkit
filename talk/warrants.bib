  section = {a11y}, move = {amplification}, from = {t-a11y-claim}, rests-on = {t-a11y-claim}, join = {, and the deliverable holds it BY CONSTRUCTION: },
  claim = {the PDF is exported in PDF/UA mode with the title carried from the config through the producer, link and equation descriptions restored, and a validator run over the result at zero failed checks},
  check = {result:render#rnd-a11y}
}
@misc{t-a11y-matrix,
  note = {Toolchain-excepted is the honest half. Some things the toolchain simply cannot express, and the grid SAYS so per cell rather than leaving a silent gap. That is what makes the rest of the grid believable.},
